{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodegen generate)",
      "Bash(xcodebuild:*)",
      "Bash(shellcheck:*)",
      "Bash(actionlint:*)",
      "Bash(pkill -x Headroom)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(security find-generic-password:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin dev:*)"
    ]
  }
}
